# Copy to .env to override defaults. Every variable is optional.

# SQLAlchemy URL. Default: a local SQLite file (gpu_lab_twin.db) in the project root.
# docker-compose sets the PostgreSQL URL below for the api container.
# GPU_TWIN_DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5433/gpu_lab_twin

# Canonical 32-node fleet fixture (validated at startup; the service refuses to start if it is not canonical).
# GPU_TWIN_FLEET_FIXTURE_PATH=fixtures/fleet.json

# Policy version cited in every decision explanation.
# GPU_TWIN_POLICY_VERSION=impl1-v1

# DEBUG | INFO | WARNING | ERROR
# GPU_TWIN_LOG_LEVEL=INFO
